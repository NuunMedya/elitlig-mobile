{
  "expo": {
    "name": "ElitLig",
    "slug": "elitlig-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "elitlig",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1310",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elitlig.app"
    },
    "android": {
      "package": "com.elitlig.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
