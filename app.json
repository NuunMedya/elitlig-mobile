{
  "expo": {
    "name": "ElitLig",
    "slug": "elitlig-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "elitlig",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08090D",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elitlig.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.elitlig.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6D28D9"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6D28D9",
          "defaultChannel": "default",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#08090D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://elitlig-api-88a866b7a4da.herokuapp.com",
      "socketUrl": "https://elitlig-api-88a866b7a4da.herokuapp.com",
      "liveSocketEnabled": true,
      "liveFallbackPollMs": 25000,
      "defaultCityId": 1,
      "router": {},
      "eas": {
        "projectId": "41ea7390-0047-4d2c-bb8b-94d3d4b20c83"
      }
    },
    "owner": "elitlig",
    "icon": "./assets/images/icon.png"
  }
}
